import pandas as pd
import numpy as np

df = pd.read_csv(r"ZoomCamp/car_fuel_efficiency_2026.csv")
print(df.shape)
print("Records:", len(df))
print("Fuel types:", df["fuel_type"].nunique())
print("Columns with missing values:", (df.isna().sum() > 0).sum())
print("Max mpg (Asia):", df.loc[df["origin"] == "Asia", "fuel_efficiency_mpg"].max())

# Horsepower and fillna
median_before = df["horsepower"].median()
mode = df["horsepower"].mode()[0]
print("\nMedian horsepower before:", median_before)
print("Most frequent horsepower:", mode)

df["horsepower"] = df["horsepower"].fillna(mode)
median_after = df["horsepower"].median()
print("Median horsepower after:", median_after)
print("Has it changed?", median_before != median_after)

# Matrix computation (Asian cars)
X = df.loc[df["origin"] == "Asia", ["vehicle_weight", "model_year"]].head(7).values
XTX = X.T @ X
XTX_inv = np.linalg.inv(XTX)
y = np.array([1100, 1300, 800, 900, 1000, 1100, 1200])
w = XTX_inv @ X.T @ y

print("\nw:", w)
print("Sum of w:", w.sum())